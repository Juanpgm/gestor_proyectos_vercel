{
  "name": "gestor-proyectos-vercel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development NEXT_PUBLIC_APP_ENV=development next dev",
    "dev:stable": "node scripts/dev-stable.js",
    "dev:production": "cross-env NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next dev",
    "build": "cross-env NODE_ENV=production next build",
    "build:dev": "cross-env NODE_ENV=development next build",
    "start": "next start",
    "start:dev": "cross-env NODE_ENV=development next start",
    "lint": "next lint",
    "test": "vitest --environment jsdom",
    "test:avances-media": "node test-avances-unidades-proyecto-media.js",
    "build:vercel": "cross-env NODE_ENV=production NEXT_PUBLIC_APP_ENV=production next build",
    "preview": "npm run build && npm run start",
    "preview:dev": "npm run build:dev && npm run start:dev",
    "preview:production": "npm run build && cross-env NODE_ENV=production npm run start",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "analyze": "cross-env ANALYZE=true next build",
    "type-check": "tsc --noEmit --project tsconfig.build.json",
    "type-check:all": "tsc --noEmit",
    "clean": "node scripts/clear-cache.js",
    "clean:all": "node scripts/clear-cache.js && npm install",
    "fresh-start": "node scripts/clear-cache.js && npm install && npm run dev",
    "env:check": "node -e \"console.log('NODE_ENV:', process.env.NODE_ENV); console.log('NEXT_PUBLIC_APP_ENV:', process.env.NEXT_PUBLIC_APP_ENV);\"",
    "env:validate": "node scripts/validate-env.js",
    "setup:env": "cp .env.example .env.local && echo '✅ Archivo .env.local creado. Por favor edítalo con tus valores reales.'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@turf/turf": "^7.2.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.3.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "next": "^14.2.31",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.49.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-leaflet": "^4.2.1",
    "react-map-gl": "^8.0.4",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.4",
    "redux": "^5.0.1",
    "shapefile": "^0.6.6",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "jsdom": "^22.0.0",
    "node-fetch": "^3.3.2",
    "vitest": "^1.0.0"
  },
  "overrides": {
    "react": "^18",
    "react-dom": "^18"
  },
  "resolutions": {
    "react": "^18",
    "react-dom": "^18"
  }
}
