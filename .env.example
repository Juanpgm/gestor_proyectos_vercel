# Environment Variables for Dashboard Alcaldía Cali

# Next.js Configuration
# Environment Variables for Sistema de Gestión de Proyectos
# Configura estas variables según tu entorno

NEXT_PUBLIC_APP_NAME=Sistema de Gestión de Proyectos
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://dashboard-alcaldia-cali.vercel.app

# ⚠️  IMPORTANTE: Copia este archivo a .env.local y reemplaza con valores reales
# ⚠️  NUNCA commitees .env.local con credenciales reales

# API Configuration - OBLIGATORIA para autenticación
NEXT_PUBLIC_API_BASE_URL=https://tu-api-backend.com
NEXT_PUBLIC_API_URL=https://tu-api-backend.com

# Firebase Configuration - REQUERIDA para Google Authentication
# Obtén estos valores desde Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Database Configuration (if needed in the future)
# DATABASE_URL=your-database-url
# DATABASE_TOKEN=your-database-token

# Analytics (if needed)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXX

# Maps Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here
NEXT_PUBLIC_DEFAULT_LATITUDE=3.4516
NEXT_PUBLIC_DEFAULT_LONGITUDE=-76.5320
NEXT_PUBLIC_DEFAULT_ZOOM=11

# Security
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=https://dashboard-alcaldia-cali.vercel.app

# Development
NODE_ENV=production
